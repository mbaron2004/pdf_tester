<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_css_test" model="ir.ui.view">
        <field name="name">sale.order.form.css.test</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_professional_quotation"
                        type="object"
                        string="Presupuesto profesional"
                        groups="sales_team.group_sale_salesman"/>
                <button name="action_print_css_test_extreme"
                        type="object"
                        string="Imprimir test CSS"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>

</odoo>
