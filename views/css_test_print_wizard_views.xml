<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="css_test_print_wizard_view_form" model="ir.ui.view">
        <field name="name">css.test.print.wizard.form</field>
        <field name="model">css.test.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir test CSS">
                <group>
                    <field name="sale_order_id"/>
                    <field name="template" widget="radio"/>
                </group>
                <footer>
                    <button name="action_print_css_test"
                            type="object"
                            string="Imprimir"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
